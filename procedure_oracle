CREATE OR REPLACE PROCEDURE get_balance(
   acc_id IN NUMBER,           -- input parameter
   acc_balance OUT NUMBER      -- output parameter
)
IS
BEGIN
   SELECT balance 
   INTO acc_balance 
   FROM accounts 
   WHERE account_id = acc_id;

EXCEPTION
   WHEN NO_DATA_FOUND THEN
      acc_balance := NULL;     -- set to NULL if account not found
END;
