🧩 Step 1 — Create the Procedure
CREATE OR REPLACE PROCEDURE withdraw_amount(
   acc_id       IN NUMBER,          -- input: account ID
   withdraw_amt IN NUMBER,          -- input: amount to withdraw
   acc_balance  IN OUT NUMBER       -- input + output: balance
)
IS
BEGIN
   -- Check for sufficient funds
   IF acc_balance >= withdraw_amt THEN
      acc_balance := acc_balance - withdraw_amt;   -- Deduct amount
      
      UPDATE accounts
      SET balance = acc_balance
      WHERE account_id = acc_id;
      
      DBMS_OUTPUT.PUT_LINE('Withdrawal successful! New Balance: ' || acc_balance);
   ELSE
      DBMS_OUTPUT.PUT_LINE('Insufficient balance! Transaction cancelled.');
   END IF;
EXCEPTION
   WHEN OTHERS THEN
      DBMS_OUTPUT.PUT_LINE('Error occurred while processing withdrawal.');
END;
/
🧩 Step 2 — Execute the Procedure
Let’s test it with Rajesh’s account (101) which currently has ₹55,000.

