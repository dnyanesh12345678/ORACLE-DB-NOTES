   v_balance NUMBER;
BEGIN
   -- Fetch current balance
   SELECT balance INTO v_balance FROM accounts WHERE account_id = 101;

   -- Try to withdraw ₹10,000
   withdraw_amount(101, 10000, v_balance);

   -- Display returned balance
   DBMS_OUTPUT.PUT_LINE('Returned (Updated) Balance: ' || v_balance);
END;
/
✅ Output:

Withdrawal successful! New Balance: 45000
Returned (Updated) Balance: 45000
